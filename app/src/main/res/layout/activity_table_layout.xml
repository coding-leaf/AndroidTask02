<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#696969"
    android:stretchColumns="1">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#555555"
        android:padding="8dp"
        android:text="Hello TableLayout"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TableRow>
        <TextView
            android:layout_column="1"
            android:padding="6dp"
            android:text="Open..."
            android:textColor="@color/white" />

        <TextView
            android:gravity="right"
            android:padding="6dp"
            android:text="Ctrl-O"
            android:textColor="@color/white" />
    </TableRow>


    <TableRow>
        <TextView
            android:layout_column="1"
            android:padding="6dp"
            android:text="Save..."
            android:textColor="@color/white" />

        <TextView
            android:gravity="right"
            android:padding="6dp"
            android:text="Ctrl-S"
            android:textColor="@color/white" />
    </TableRow>


    <TableRow>
        <TextView
            android:layout_column="1"
            android:padding="6dp"
            android:text="Save As..."
            android:textColor="@color/white" />

        <TextView
            android:gravity="right"
            android:padding="6dp"
            android:text="Ctrl-Shift-S"
            android:textColor="@color/white" />
    </TableRow>


    <View
        android:layout_height="1dp"
        android:background="#FFFFFF" />


    <TableRow>
        <TextView
            android:padding="6dp"
            android:text="X"
            android:textColor="@color/white" />

        <TextView
            android:padding="6dp"
            android:text="Import..."
            android:textColor="@color/white" />
    </TableRow>


    <TableRow>
        <TextView
            android:padding="6dp"
            android:text="X"
            android:textColor="@color/white" />

        <TextView
            android:padding="6dp"
            android:text="Export..."
            android:textColor="@color/white" />

        <TextView
            android:gravity="right"
            android:padding="6dp"
            android:text="Ctrl-E"
            android:textColor="@color/white" />
    </TableRow>


    <View
        android:layout_height="1dp"
        android:background="#FFFFFF" />


    <TableRow>
        <TextView
            android:layout_column="1"
            android:padding="6dp"
            android:text="Quit"
            android:textColor="@color/white" />
    </TableRow>
</TableLayout>